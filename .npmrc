# Supply-chain defaults for everyone who works on this repo (CI uses the same file).
# Never run dependency install scripts: this is how Shai-Hulud-style worms spread.
ignore-scripts=true
# Record exact versions, so an update is always a reviewed lockfile change.
save-exact=true
# Only the public registry, over https.
registry=https://registry.npmjs.org/
engine-strict=true
fund=false
